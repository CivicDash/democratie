# Mailu configuration pour civis-consilium.eu
# Copier vers mailu.env et adapter les valeurs

# Domaine principal
DOMAIN=civis-consilium.eu
HOSTNAMES=mail.civis-consilium.eu

# Clé secrète (générer avec: openssl rand -hex 32)
SECRET_KEY=CHANGER_CETTE_CLE_SECRETE

# Réseau
SUBNET=192.168.203.0/24
BIND_ADDRESS4=0.0.0.0

# Chemins
ROOT=/opt/mailu

# Mode (behind reverse proxy)
TLS_FLAVOR=mail
REAL_IP_HEADER=X-Forwarded-For
REAL_IP_FROM=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# Admin
ADMIN=true
WEBMAIL=roundcube
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail

# Compte admin initial (changer après première connexion)
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=civis-consilium.eu
INITIAL_ADMIN_PW=ChangerCeMotDePasse!

# Logs
LOG_LEVEL=WARNING

# Quotas (1Go par défaut)
DEFAULT_QUOTA=1000000000

# Antispam
ANTISPAM=rspamd

# Messages
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=50/day

# Fetchmail (désactivé)
FETCHMAIL_ENABLED=false

# Postgres (optionnel, sqlite par défaut)
# DB_FLAVOR=postgresql
# DB_HOST=civicdash_db
# DB_NAME=mailu
# DB_USER=mailu
# DB_PW=secret
