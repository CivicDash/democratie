# =============================================================================
# CivicDash - Variables d'Environnement Production
# =============================================================================
# Copier ce fichier vers .env et adapter les valeurs
# cp docker/production/env.production.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="CivicDash"
APP_ENV=production
APP_KEY=                                 # Générer avec: php artisan key:generate
APP_DEBUG=false
APP_URL=https://demo.objectif2027.fr

# Domaine principal (utilisé par Traefik)
DOMAIN=demo.objectif2027.fr

# Email pour Let's Encrypt
ACME_EMAIL=admin@civis-consilium.eu

# -----------------------------------------------------------------------------
# BASE DE DONNÉES
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgbouncer                        # Via PgBouncer, pas directement PostgreSQL
DB_PORT=6432                             # Port PgBouncer (pas 5432)
DB_DATABASE=civicdash
DB_USERNAME=civicdash
DB_PASSWORD=                             # Mot de passe fort (32+ caractères)

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                          # Optionnel mais recommandé en production

# Drivers
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# MEILISEARCH
# -----------------------------------------------------------------------------
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=                         # Clé master forte
SCOUT_DRIVER=meilisearch

# -----------------------------------------------------------------------------
# MAIL (via Mailu interne)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailu-front-1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@civis-consilium.eu"
MAIL_FROM_NAME="CivicDash"

# Contourner les problèmes SSL Docker interne
MAIL_URL=smtp://mailu-front-1:25?verify_peer=0

# -----------------------------------------------------------------------------
# SÉCURITÉ
# -----------------------------------------------------------------------------
# Pepper pour le hashing (générer avec: php -r "echo base64_encode(random_bytes(32));")
PEPPER=

# Session sécurisée
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Sanctum
SANCTUM_STATEFUL_DOMAINS=${DOMAIN}

# FranceConnect (si activé)
FRANCECONNECT_CLIENT_ID=
FRANCECONNECT_CLIENT_SECRET=
FRANCECONNECT_REDIRECT_URI=https://${DOMAIN}/auth/franceconnect/callback

# -----------------------------------------------------------------------------
# MONITORING (Optionnel)
# -----------------------------------------------------------------------------
# Sentry
SENTRY_LARAVEL_DSN=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=                        # Mot de passe fort

# -----------------------------------------------------------------------------
# TRAEFIK
# -----------------------------------------------------------------------------
# Auth pour le dashboard Traefik (générer avec: htpasswd -nb admin password)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz

# -----------------------------------------------------------------------------
# OCTANE
# -----------------------------------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DIVERS
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
