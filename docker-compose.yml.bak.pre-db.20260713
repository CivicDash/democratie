services:
  app:
    build:
      context: .
      dockerfile: Dockerfile.frankenphp
    image: civicdash-prod:latest
    container_name: cd_prod_app
    restart: unless-stopped
    working_dir: /app
    deploy:
      resources:
        limits:
          cpus: '4'
          memory: 3G
        reservations:
          cpus: '2'
          memory: 1G
    volumes:
      - app_storage:/app/storage
      - ./.env:/app/.env:ro
    ports:
      - "127.0.0.1:8090:80"
    depends_on:
      redis:
        condition: service_healthy
      meilisearch:
        condition: service_healthy
    networks:
      - civicdash_prod
      - civicdash_shared
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/up"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  horizon:
    image: civicdash-prod:latest
    container_name: cd_prod_horizon
    restart: unless-stopped
    working_dir: /app
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 1536M
        reservations:
          cpus: '1'
          memory: 512M
    volumes:
      - app_storage:/app/storage
      - ./.env:/app/.env:ro
    entrypoint: ["php", "artisan", "horizon"]
    depends_on:
      - app
      - redis
    networks:
      - civicdash_prod
      - civicdash_shared
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"

  scheduler:
    image: civicdash-prod:latest
    container_name: cd_prod_scheduler
    restart: unless-stopped
    working_dir: /app
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
    volumes:
      - app_storage:/app/storage
      - ./.env:/app/.env:ro
    entrypoint: ["sh", "-c", "while true; do php artisan schedule:run --verbose --no-interaction; sleep 60; done"]
    depends_on:
      - app
      - redis
    networks:
      - civicdash_prod
      - civicdash_shared
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"

  redis:
    image: redis:7-alpine
    container_name: cd_prod_redis
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1G
    command: >
      redis-server
      --appendonly yes
      --appendfsync everysec
      --maxmemory 768mb
      --maxmemory-policy allkeys-lru
      --save 900 1
      --save 300 10
      --save 60 10000
      --tcp-keepalive 300
    ports:
      - "127.0.0.1:6381:6379"
    volumes:
      - redis_data:/data
    networks:
      - civicdash_prod
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  meilisearch:
    image: getmeili/meilisearch:v1.6
    container_name: cd_prod_search
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 1G
    environment:
      MEILI_MASTER_KEY: ${MEILISEARCH_KEY}
      MEILI_NO_ANALYTICS: true
      MEILI_ENV: production
      MEILI_MAX_INDEXING_MEMORY: 512Mb
      MEILI_MAX_INDEXING_THREADS: 2
      MEILI_LOG_LEVEL: WARN
    ports:
      - "127.0.0.1:7701:7700"
    volumes:
      - meilisearch_data:/meili_data
    networks:
      - civicdash_prod
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:7700/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

volumes:
  app_storage:
    driver: local
  redis_data:
    driver: local
  meilisearch_data:
    driver: local

networks:
  civicdash_prod:
    driver: bridge
  civicdash_shared:
    external: true
